{
  "manifest_version": 3,
  "name": "Capri — suas abas",
  "version": "1.1.0",
  "description": "Deixa a Capri (o pet da sua área de trabalho) ver e organizar suas abas quando você pede: contar, fechar, guardar pra depois, resumir a página. Só conversa com a Capri no seu PC.",
  "permissions": [
    "alarms",
    "scripting",
    "storage",
    "tabs"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "128": "icon.png"
  },
  "action": {
    "default_title": "Capri — suas abas",
    "default_icon": "icon.png"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "focus.html"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ]
}